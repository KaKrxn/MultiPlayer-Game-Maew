<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="network-main-container"
                      style="flex-grow: 1; justify-content: center; align-items: center; padding-left: 20px; padding-right: 20px; padding-top: 20px; padding-bottom: 20px;">

        <ui:VisualElement name="connection-panel"
                          style="width: 420px; padding-left: 20px; padding-right: 20px; padding-top: 20px; padding-bottom: 20px; background-color: rgb(30,30,46); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">

            <ui:Label text="Network Connection"
                      style="font-size: 24px; unity-font-style: bold; color: white; margin-bottom: 8px;" />

            <ui:Label text="Enter your player name before joining"
                      style="font-size: 12px; color: rgb(184,184,200); margin-bottom: 16px;" />

            <ui:TextField name="player-name-field"
                          label="Player Name"
                          value="Player"
                          style="margin-bottom: 16px;" />

            <ui:VisualElement name="button-container"
                              style="flex-direction: row; justify-content: space-between;">

                <ui:Button name="host-button"
                           text="Start Host"
                           style="flex-grow: 1; margin-right: 4px;" />

                <ui:Button name="client-button"
                           text="Start Client"
                           style="flex-grow: 1; margin-left: 4px;" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>